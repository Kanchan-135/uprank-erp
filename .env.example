# ================================================================
# UPRANK SCHOOL ERP — ENVIRONMENT CONFIGURATION
# ================================================================

# 1. DATABASE CONFIGURATION
# ----------------------------------------------------------------
# For Persistent Container / Docker / VPS / Local (SQLite):
DATABASE_URL="file:./dev.db"

# For Serverless Cloud / Vercel / Neon / Supabase (PostgreSQL):
# 1. Change `provider = "sqlite"` to `provider = "postgresql"` in prisma/schema.prisma
# 2. Set your hosted PostgreSQL connection string below:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?sslmode=require"

# 2. AUTHENTICATION & SECURITY
# ----------------------------------------------------------------
# Mandatory: 32+ character cryptographically random string
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="uprank-erp-super-secure-production-secret-key-change-this-2025"

# 3. CANONICAL APP URL
# ----------------------------------------------------------------
# Public HTTPS URL of the deployed application (used for PWA & redirection)
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# 4. RUNTIME SETTINGS
# ----------------------------------------------------------------
NODE_ENV="production"
PORT=3000

# Optional: Set to true if creating a Docker image with standalone output
# BUILD_STANDALONE="true"
