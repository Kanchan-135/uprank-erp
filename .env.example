# ================================================================
# UPRANK SCHOOL ERP — ENVIRONMENT CONFIGURATION
# ================================================================

# 1. DATABASE CONFIGURATION
# ----------------------------------------------------------------
# Hosted PostgreSQL (Supabase, Neon, AWS RDS, etc.):
DATABASE_URL="postgresql://postgres:[USERNAME]:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# (Optional) If reverting to local SQLite:
# 1. Change `provider = "postgresql"` to `provider = "sqlite"` in prisma/schema.prisma
# 2. Set DATABASE_URL="file:./dev.db"

# 2. AUTHENTICATION & SECURITY
# ----------------------------------------------------------------
# Mandatory: 32+ character cryptographically random string
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="uprank-erp-super-secure-production-secret-key-change-this-2025"

# 3. CANONICAL APP URL
# ----------------------------------------------------------------
# Public HTTPS URL of the deployed application (used for PWA & redirection)
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# 4. RUNTIME SETTINGS
# ----------------------------------------------------------------
NODE_ENV="production"
PORT=3000

# Optional: Set to true if creating a Docker image with standalone output
# BUILD_STANDALONE="true"
